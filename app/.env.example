# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (never committed). Every variable by name; standards/fullstack-build-standard.md §3.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Two accepted shapes. DB_HOST decides: when it is set the DB_* block is used and DATABASE_URL is IGNORED.
# 1. Development — one URL:
DATABASE_URL=postgres://postgres@localhost:5432/market-intel-os_dev
# 2. Deployment — the discrete form CP Portal / Pucho DB injects. Leave unset locally:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SCHEMA=public
# TLS is derived from the host (local plain, remote encrypted). Production verifies the certificate against DB_SSL_CA (§19.1).
# DB_SSL=
# DB_SSL_CA=
# DB_TIMEZONE=Asia/Kolkata   # the zone timestamps are reported in (API answers, Studio reads)

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# The public origin of this app. https:// turns on HSTS and the __Host- session cookie; the Origin check on
# cookie-authenticated Route Handlers compares against it (§19.2).
APP_ORIGIN=http://localhost:3000
# Keys the HMAC of one-time sign-in codes (§19.2). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_PEPPER=

# ── Workflows (Pucho AI Studio) ──────────────────────────────────────────────
# One URL per flow the app calls, from docs/import-sheet.md after step 6. A URL is a door: it is a secret and never
# reaches the browser. Unset = that flow's actions are SIMULATED by the app (header shows it; docs/security.md says so).
# WEBHOOK_MARKET_REPORT=
# WEBHOOK_BROADCAST=
# The flow that delivers one-time sign-in codes by email (the app generates, hashes and checks the code; the flow only sends).
# WEBHOOK_AUTH_OTP=   # unset = the login page offers no one-time code (codes are never logged, S6)
# The token a flow presents when it calls THIS app (/api/data, /api/jobs). UNSET MEANS CLOSED (403), not open.
# Prefer one per flow — INBOUND_TOKEN_<FLOW> (the CHECKLIST names it; the audit row records which one was used) — or one shared
# INBOUND_TOKEN. INBOUND_TOKEN_NEXT is the incoming token during a rotation (docs/security.md § Inbound tokens).
# INBOUND_TOKEN=
# INBOUND_TOKEN_NEXT=
# Behind a reverse proxy (CP Portal): how many proxy hops add X-Forwarded-For entries (1 behind the portal). The sign-in
# rate limit reads the client address that many hops from the right; unset = the per-account limit only (§19.2, S5).
# TRUST_PROXY_HOPS=1

# ── Files (uploads are stored in PostgreSQL, D6) ────────────────────────────
# FILES_MAX_MB=10            # one file
# FILES_CAP_MB=400           # all files together — the Pucho DB plan's storage cap, minus headroom

# ── Field-level encryption (only if the OS stores Aadhaar / PAN / bank / health data, §19.7) ─────────
# FIELD_ENC_KEYS=v1:<base64 32 bytes>
# FIELD_ENC_CURRENT=v1
# BLIND_INDEX_KEY=<base64 32 bytes>

# ── Demo deployments only ───────────────────────────────────────────────────
# DEMO_LOGINS=true   # the login page lists the demo personas from db/seed/users.json (client click-through, step 5) and signs them in
#                    # without a password — a LOCAL or demo database only: the server refuses to start with it beside a DB_HOST.
#                    # DEMO_LOGINS=portal-demo is the said-aloud exception for a demo deployment on CP Portal (demo data only). NEVER on a client's deployment.
# NEXT_PUBLIC_* is COMPILED INTO THE BUNDLE. Never a secret behind this prefix (npm run check enforces it).
