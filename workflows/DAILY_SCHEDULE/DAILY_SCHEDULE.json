            "sourceCode": {
              "code": "// @ts-nocheck\n// lib: app/src/custom/lib/market.js + market-flow.js — only what scheduleGate() reaches (tools/build_market_flows.py)\nconst asDate = (at) => (at instanceof Date ? at : new Date(at || Date.now()));\nfunction istDate(at) {\n  const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(asDate(at)).map((x) => [x.type, x.value]));\n  return `${p.year}-${p.month}-${p.day}`;\n}\nfunction istWeekday(at) { return new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'short' }).format(asDate(at)); }\nconst nowOf = (inp) => (inp && inp.now ? new Date(inp.now) : new Date());\nconst listOf = (v) => (Array.isArray(v) ? v : []);\nconst holidaysOf = (C) => listOf(C && C.holidays).map((d) => String(d).slice(0, 10));\nfunction scheduleGate(inp) {\n  const C = (inp && inp.C) || {}; const now = nowOf(inp); const today = istDate(now); const day = istWeekday(now);\n  if (day === 'Sat' || day === 'Sun') return { route: 'skip', today, reason: `${day} — the market is closed` };\n  if (holidaysOf(C).includes(today)) return { route: 'skip', today, reason: `${today} is in constants.holidays (NSE holiday)` };\n  return { route: 'run', today, reason: '' };\n}\n// end lib\nexport const code = async (inputs) => {\n  return scheduleGate(inputs);\n};",
