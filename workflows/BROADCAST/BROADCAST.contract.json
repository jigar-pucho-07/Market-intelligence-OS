{
  "flow": "BROADCAST",
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "@puchoaistudio/tool-gmail",
    "@puchoaistudio/tool-http",
    "@puchoaistudio/tool-webhook",
    "@puchoaistudio/tool-zerobounce"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_email",
    "send_request",
    "validateEmail"
  ],
  "require_capabilities": [
    "webhook=trigger:webhook:trigger",
    "auth_gate=step_constants:code:transform",
    "answer_unauthorized=step_denied_done:webhook:respond",
    "answer_bad_action=step_bad_action_done:webhook:respond",
    "route=step_router:router:route",
    "read_reports=step_send_reports:http:read",
    "read_subscribers=step_send_subscribers:http:read",
    "plan=step_send_plan:code:transform",
    "queue=step_send_queue:http:write",
    "verify=step_send_zb:zerobounce:action",
    "deliverable=step_send_valid:router:route",
    "invalid_update=step_send_invalid:http:write",
    "send=step_send_email:gmail:write",
    "result=step_send_result:code:transform",
    "delivery_update=step_send_update:http:write",
    "publish=step_send_publish:http:write",
    "answer_send=step_send_done:webhook:respond",
    "retry_read_deliveries=step_retry_deliveries:http:read",
    "retry_read_subscribers=step_retry_subscribers:http:read",
    "retry_read_reports=step_retry_reports:http:read",
    "retry_plan=step_retry_plan:code:transform",
    "retry_claim=step_retry_claim:http:write",
    "retry_verify=step_retry_zb:zerobounce:action",
    "retry_deliverable=step_retry_valid:router:route",
    "retry_invalid_update=step_retry_invalid:http:write",
    "answer_retry_invalid=step_retry_invalid_done:webhook:respond",
    "retry_send=step_retry_email:gmail:write",
    "retry_result=step_retry_result:code:transform",
    "retry_update=step_retry_update:http:write",
    "retry_publish=step_retry_publish:http:write",
    "answer_retry_sent=step_retry_sent:webhook:respond",
    "answer_retry_refused=step_retry_done:webhook:respond"
  ],
  "built_by": "tools/build_market_flows.py"
}
