                "sampleData": {},
                "sourceCode": {
                  "code": "// @ts-nocheck\n// lib: app/src/custom/lib/market.js + market-flow.js — only what reportGate() reaches (tools/build_market_flows.py)\nconst ENUMS = {\n  Sentiment: ['BULLISH', 'CAUTIOUSLY BULLISH', 'NEUTRAL', 'CAUTIOUSLY BEARISH', 'BEARISH'],\n  Confidence_Level: ['HIGH', 'MEDIUM', 'LOW'],\n  Outlook: ['BULLISH', 'BEARISH', 'NEUTRAL', 'CAUTIOUS'],\n  FnO_View: ['BULLISH BIAS', 'BEARISH BIAS', 'RANGE-BOUND', 'VOLATILE'],\n  VIX_Expectation: ['LOW', 'MEDIUM', 'HIGH'],\n  SectorCall: ['POSITIVE', 'WATCH', 'NEGATIVE'],\n  RiskLevel: ['HIGH', 'MED'],\n  Trigger: ['Schedule', 'Manual'],\n  Opt_In_Source: ['WhatsApp reply', 'Web form', 'Signed form', 'Phone call'],\n};\nconst asDate = (at) => (at instanceof Date ? at : new Date(at || Date.now()));\nfunction istDate(at) {\n  const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(asDate(at)).map((x) => [x.type, x.value]));\n  return `${p.year}-${p.month}-${p.day}`;\n}\nfunction rowsOf(out) { const b = out && typeof out === 'object' ? out.body : undefined; return Array.isArray(b) ? b : Array.isArray(out) ? out : null; }\nfunction statusOf(out) {\n  if (out && (out.status ?? out.statusCode) != null) return Number(out.status ?? out.statusCode);\n  const m = out && out.error ? String(out.error.message || out.error).match(/(?:^|[^0-9])([1-5]\\d\\d)(?![0-9])/) : null;\n  return m ? Number(m[1]) : out && out.error ? 0 : 200;\n}\nfunction doorError(out, entity) {\n  const s = statusOf(out);\n  return s === 403 ? `APP_CLOSED: the app refused the ${entity} read (403) — set INBOUND_TOKEN on the app and the same token in this flow's constants`\n    : `APP_READ_FAILED: could not read ${entity} from the app (${s || (out && out.error) || 'no response'})`;\n}\nconst JOB = /^JOB-[0-9A-F]{12}$/;\nfunction jobItems(job, status, result) { return JOB.test(String(job || '')) ? [{ id: String(job), status, result }] : []; }\nconst nowOf = (inp) => (inp && inp.now ? new Date(inp.now) : new Date());\nconst ACTIONS = ['run', 'rerun'];\n\n// ─────────────────────────────── MARKET_REPORT ───────────────────────────────\nfunction decideReport(Mode, reportId, rows, reportDate, today, Trigger = 'Manual') {\n  const no = (code, error) => ({ route: 'refuse', code, error, target: null });\n  if (Mode === 'run') {\n    const existing = rows.find((r) => r.Report_Date === reportDate);\n    if (!existing) return { route: 'new', code: '', error: '', target: null };\n    if (existing.Status === 'Failed' || Trigger === 'Manual') return { route: 'rerun', code: '', error: '', target: existing };\n    return no('EXISTS', `Today's report already exists (${existing.Report_ID}, ${existing.Status}) — the schedule does not overwrite a Ready or Sent report`);\n  }\n  if (Mode !== 'rerun') return no('INVALID_INPUT', 'the action must be run or rerun');\n  const target = rows.find((r) => r.Report_ID === String(reportId || ''));\n  if (!target) return no('NOT_FOUND', `No report ${String(reportId || '').slice(0, 30)}`);\n  if (target.Report_Date !== today) return no('STALE_DATE', `${target.Report_ID} is for ${target.Report_Date}; the feeds carry today's news, so only today's report can be re-run`);\n  return { route: 'rerun', code: '', error: '', target };\n}\nfunction reportGate(inp) {\n  const body = (inp && inp.body) || {}; const now = nowOf(inp); const today = istDate(now);\n  const Mode = ACTIONS.includes(body.action) ? body.action : '';\n  const Trigger = Mode === 'run' && ENUMS.Trigger.includes(body.Trigger) ? body.Trigger : 'Manual';\n  const rows = rowsOf(inp && inp.reports);\n  const d = !rows ? { route: 'refuse', code: statusOf(inp.reports) === 403 ? 'APP_CLOSED' : 'APP_READ_FAILED', error: doorError(inp.reports, 'reports') }\n    : decideReport(Mode, body.Report_ID, rows, today, today, Trigger);\n  const go = d.route !== 'refuse';\n  return { route: go ? 'go' : 'refuse', code: d.code, error: d.error, Mode, Trigger, Report_ID: Mode === 'rerun' ? String(body.Report_ID || '') : '',\n    _job: String(body._job || ''), jobs: go ? [] : jobItems(body._job, 'failed', { code: d.code, error: d.error }) };\n}\n// end lib\nexport const code = async (inputs) => {\n  return reportGate(inputs);\n};",
                  "packageJson": "{}"
