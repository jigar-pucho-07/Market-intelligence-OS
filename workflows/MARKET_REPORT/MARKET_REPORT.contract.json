{
  "flow": "MARKET_REPORT",
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "@puchoaistudio/tool-http",
    "@puchoaistudio/tool-webhook"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_request"
  ],
  "require_capabilities": [
    "webhook=trigger:webhook:trigger",
    "auth_gate=step_constants:code:transform",
    "answer_unauthorized=step_denied_done:webhook:respond",
    "answer_bad_action=step_bad_action_done:webhook:respond",
    "auth_route=step_auth:router:route",
    "read_reports=step_read_reports:http:read",
    "gate=step_gate:code:transform",
    "route=step_router:router:route",
    "refuse_job=step_refuse_job:http:write",
    "answer_refused=step_refuse_done:webhook:respond",
    "start_analysis=step_analyse_post:http:write",
    "answer_queued=step_analyse_done:webhook:respond"
  ],
  "built_by": "tools/build_market_flows.py"
}
